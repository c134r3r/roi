# ============================================================================
# DEVELOPMENT (localhost)
# ============================================================================

# Backend Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (for future use)
DATABASE_URLROI=postgresql://user:password@localhost:5432/roi_calculator

# Optional: Google Slides API (for export feature)
GOOGLE_SHEETS_API_KEY=

# Session Cleanup (days)
PROJECT_EXPIRATION_DAYS=60

# ============================================================================
# VERCEL DEPLOYMENT
# ============================================================================
# Add these environment variables in Vercel project settings:
#
# VITE_API_URL=https://your-backend-domain.com
#   (Replace with actual backend URL - e.g., https://roi-backend.railway.app)
#   If not set, defaults to http://localhost:3001 (development)
#
# Note: The frontend will be hosted on Vercel
#       The backend should be hosted separately (Railway, Render, Heroku, etc.)
# ============================================================================
