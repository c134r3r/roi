# PRODUCTION Environment Configuration
# Kopiere diese Datei zu .env.production und fülle die Werte aus

# ===== DATABASE =====
# NEON PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URLROI=postgresql://user:password@ec2-...neon.tech:5432/neondb

# Enable PostgreSQL (wichtig für Production!)
USE_POSTGRES=true

# ===== SERVER =====
# Port wird von Vercel ignoriert, nur für lokales Testing
PORT=3001

# ===== ENVIRONMENT =====
NODE_ENV=production

# ===== CORS =====
# Frontend Domain - MUSS gesetzt sein für CORS!
# Beispiel: https://roi-calculator.vercel.app
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# ===== OPTIONAL =====
# API_RATE_LIMIT=100  # Requests pro Minute
# API_TIMEOUT=30000   # Request Timeout in ms
