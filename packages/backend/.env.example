# ROI Calculator Backend Configuration

# Server Port
PORT=3001

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Leave empty to use In-Memory database (default for development)
# Set DATABASE_URL to enable PostgreSQL persistence

# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/roi_calculator
DATABASE_URL=

# Enable PostgreSQL explicitly (optional if DATABASE_URL is set)
USE_POSTGRES=false

# Node environment
NODE_ENV=development
