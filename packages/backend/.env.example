# ROI Calculator Backend Configuration

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Option 1: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/roi_calculator
# USE_POSTGRES=true

# Option 2: NEON (Recommended for Vercel)
# Get from: https://neon.tech → Dashboard → Connection String
# DATABASE_URL=postgresql://neon_user:password@ep-xxx.region.neon.tech/roi_calculator?sslmode=require
# USE_POSTGRES=true

# Option 3: In-Memory (Default for Development)
# Leave DATABASE_URL empty
DATABASE_URL=

# Enable PostgreSQL (auto-detected from DATABASE_URL, but can be explicit)
USE_POSTGRES=false

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server Port (default: 3001)
PORT=3001

# Frontend CORS Origin (adjust for your deployment)
CORS_ORIGIN=http://localhost:5173

# Node environment (development, production, staging)
NODE_ENV=development

# ============================================
# VERCEL DEPLOYMENT
# ============================================

# For Vercel deployments, set DATABASE_URL as a Secret:
# 1. Vercel Dashboard → Project → Settings → Environment Variables
# 2. Name: DATABASE_URL
# 3. Value: postgresql://neon_user:password@ep-xxx.region.neon.tech/roi_calculator?sslmode=require
# 4. Add to: Production, Preview, Development (or as needed)
#
# Then push to GitHub and Vercel will auto-deploy with the variable set.
